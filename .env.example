# Environment template - do NOT commit secrets
NODE_ENV=development
# Public runtime value (safe for browser exposure)
NUXT_PUBLIC_SUPABASE_URL=
# Public runtime value (anon key only, never service role)
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (never expose to browser, never commit real values)
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
